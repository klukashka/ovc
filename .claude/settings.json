{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(git rebase *)",
      "Bash(git * rebase *)",
      "Bash(git reset *)",
      "Bash(git * reset *)",
      "Bash(git clean *)",
      "Bash(git * clean *)",
      "Bash(git branch -D *)",
      "Bash(git * branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git * checkout -- *)",
      "Bash(git checkout HEAD -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout -f*)",
      "Bash(git switch -f*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git * restore *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git commit --amend*)",
      "Bash(git filter-branch*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "Bash(git update-ref *)",
      "Bash(git branch --delete --force*)",
      "Bash(git branch -d -f*)",
      "Bash(git branch -f *)",
      "Bash(git checkout * -- *)",
      "Bash(git * checkout * -- *)",
      "Bash(git checkout -B*)",
      "Bash(git * checkout -B*)",
      "Bash(git switch -C*)",
      "Bash(git * switch -C*)",
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git * worktree remove --force*)",
      "Bash(git * worktree remove -f*)",
      "Bash(git checkout *)",
      "Bash(git * checkout *)",
      "Bash(git switch --force*)",
      "Bash(git * switch --force*)",
      "Bash(git * switch -f*)",
      "Bash(git * switch --discard-changes*)",
      "Bash(git worktree remove * --force*)",
      "Bash(git worktree remove * -f*)",
      "Bash(git * worktree remove * --force*)",
      "Bash(git * worktree remove * -f*)",
      "Bash(git * stash drop*)",
      "Bash(git * stash clear*)",
      "Bash(git * commit --amend*)",
      "Bash(git * filter-branch*)",
      "Bash(git * reflog expire*)",
      "Bash(git * gc --prune*)",
      "Bash(git * update-ref *)",
      "Bash(git * branch --delete --force*)",
      "Bash(git * branch -d -f*)",
      "Bash(git * branch -f *)",
      "Bash(git branch * -D*)",
      "Bash(git * branch * -D*)",
      "Bash(git branch -M*)",
      "Bash(git * branch -M*)",
      "Bash(git branch -C*)",
      "Bash(git * branch -C*)",
      "Bash(git branch --force*)",
      "Bash(git * branch --force*)",
      "Bash(git tag -d*)",
      "Bash(git * tag -d*)",
      "Bash(git tag -f*)",
      "Bash(git * tag -f*)",
      "Bash(git rm -f*)",
      "Bash(git * rm -f*)",
      "Bash(git rm --force*)",
      "Bash(git * rm --force*)",
      "Bash(git *--force*)",
      "Bash(git *--amend*)",
      "Bash(git *--discard-changes*)",
      "Bash(git * -f)",
      "Bash(git * -f *)",
      "Bash(git branch -df*)",
      "Bash(git branch -fd*)",
      "Bash(git * branch -df*)",
      "Bash(git * branch -fd*)",
      "Bash(git rm -rf*)",
      "Bash(git rm -fr*)",
      "Bash(git * rm -rf*)",
      "Bash(git * rm -fr*)",
      "Bash(git rm * -rf*)",
      "Bash(git rm * -fr*)",
      "Bash(git * rm * -rf*)",
      "Bash(git * rm * -fr*)",
      "Bash(git checkout-index *)",
      "Bash(git * checkout-index *)",
      "Bash(git read-tree *)",
      "Bash(git * read-tree *)",
      "Bash(git tag --delete*)",
      "Bash(git * tag --delete*)",
      "Bash(git reflog delete*)",
      "Bash(git * reflog delete*)",
      "Bash(git prune*)",
      "Bash(git * prune*)",
      "Bash(git branch * -df*)",
      "Bash(git branch * -fd*)",
      "Bash(git * branch * -df*)",
      "Bash(git * branch * -fd*)",
      "Bash(git *--am*)",
      "Bash(git *--forc*)",
      "Bash(git *--disc*)",
      "Bash(git rebase)",
      "Bash(git reset)",
      "Bash(git clean)",
      "Bash(git * rebase)",
      "Bash(git * reset)",
      "Bash(git * clean)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/*.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.local.*)",
      "Read(**/.env.ci)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/.env.testing)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(**/.env.stage)",
      "Read(**/.env.preview)",
      "Read(**/.env.secret)",
      "Read(**/.env.secrets)",
      "Read(**/.env.*.bak)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Bash(sudo *)",
      "Edit(//etc/**)",
      "Edit(//usr/**)",
      "Edit(//System/**)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_secrets.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_check.py\""
          }
        ]
      }
    ]
  }
}
