{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(git rebase *)",
      "Bash(git * rebase *)",
      "Bash(git reset *)",
      "Bash(git * reset *)",
      "Bash(git clean *)",
      "Bash(git * clean *)",
      "Bash(git branch -D *)",
      "Bash(git * branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git * checkout -- *)",
      "Bash(git checkout HEAD -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout -f*)",
      "Bash(git switch -f*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git * restore *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git commit --amend*)",
      "Bash(git filter-branch*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "Bash(git update-ref *)",
      "Bash(git branch --delete --force*)",
      "Bash(git branch -d -f*)",
      "Bash(git branch -f *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/*.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.local.*)",
      "Read(**/.env.ci)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/.env.testing)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(**/.env.stage)",
      "Read(**/.env.preview)",
      "Read(**/.env.secret)",
      "Read(**/.env.secrets)",
      "Read(**/.env.*.bak)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Bash(sudo *)",
      "Edit(//etc/**)",
      "Edit(//usr/**)",
      "Edit(//System/**)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_secrets.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_check.py\""
          }
        ]
      }
    ]
  }
}
